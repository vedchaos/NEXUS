# === NEXUS .gitignore ===

# Environment & Secrets
config/.env
*.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/

# Data (runtime - never commit)
data/cache/
data/memory/
data/logs/
data/scan_results/
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Ollama models (too large)
models/

# Node
node_modules/
package-lock.json

# Temp
*.tmp
*.temp
*.bak
