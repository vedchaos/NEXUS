{
  "$schema": "https://opencode.ai/config.json",
  "username": "ctz-operator",
  "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
  "small_model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
  "default_agent": "ctz",
  "shell": "powershell",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": false,
  "instructions": ["SOUL_CTZ.md"],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "agent": {
    "ctz": {
      "description": "CHAOS TYPE ZERO primary agent — autonomous AI OS with 3-tier memory, multi-provider LLM, security scanning, ML pipeline, voice/vision.",
      "mode": "primary",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
      "color": "error"
    },
    "ctz-recon": {
      "description": "Reconnaissance subagent. Passive + active recon, OSINT, subdomain enumeration.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "ctz-scan": {
      "description": "Vulnerability scanning subagent. Nmap, Nuclei, Nikto, Gobuster.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "ctz-exploit": {
      "description": "Exploitation subagent. SQLMap, Hydra, Metasploit. AUTHORIZATION REQUIRED.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "ctz-ml": {
      "description": "ML development subagent. Training, evaluation, deployment pipelines.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "ctz-code": {
      "description": "Code review and development subagent.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    }
  },

  "mcp": {
    "ctz-brain": {
      "type": "local",
      "command": ["python", "mcp_servers/llm_fallback.py"],
      "enabled": true
    },
    "ctz-memory": {
      "type": "local",
      "command": ["python", "mcp_servers/memory_mcp.py"],
      "enabled": true
    },
    "ctz-router": {
      "type": "local",
      "command": ["python", "mcp_servers/task_router_mcp.py"],
      "enabled": true
    },
    "ctz-security": {
      "type": "local",
      "command": ["python", "mcp_servers/pentest_mcp.py"],
      "enabled": true
    },
    "ctz-orchestrator": {
      "type": "local",
      "command": ["python", "mcp_servers/ctz_orchestrator_mcp.py"],
      "enabled": true
    },
    "ctz-voice": {
      "type": "local",
      "command": ["python", "mcp_servers/voice_mcp.py"],
      "enabled": true
    },
    "ctz-vision": {
      "type": "local",
      "command": ["python", "mcp_servers/vision_mcp.py"],
      "enabled": true
    },
    "ctz-ml": {
      "type": "local",
      "command": ["python", "mcp_servers/ml_mcp.py"],
      "enabled": true
    },
    "ctz-automation": {
      "type": "local",
      "command": ["python", "mcp_servers/automation_mcp.py"],
      "enabled": true
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "python *": "allow",
      "pip *": "allow",
      "ollama *": "allow",
      "nmap *": "ask",
      "nuclei *": "ask",
      "nikto *": "ask",
      "gobuster *": "ask",
      "sqlmap *": "ask",
      "hydra *": "ask",
      "git *": "allow",
      "curl *": "allow",
      "wsl *": "ask",
      "*": "ask"
    }
  }
}
