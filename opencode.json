{
  "$schema": "https://opencode.ai/config.json",
  "username": "nexus-operator",
  "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
  "small_model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
  "default_agent": "nexus",
  "shell": "powershell",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": false,
  "instructions": ["SOUL_NEXUS.md"],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "agent": {
    "nexus": {
      "description": "NEXUS primary agent — autonomous AI OS with 3-tier memory, multi-provider LLM, security scanning, ML pipeline, voice/vision.",
      "mode": "primary",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b",
      "color": "error"
    },
    "nexus-recon": {
      "description": "Reconnaissance subagent. Passive + active recon, OSINT, subdomain enumeration.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "nexus-scan": {
      "description": "Vulnerability scanning subagent. Nmap, Nuclei, Nikto, Gobuster.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "nexus-exploit": {
      "description": "Exploitation subagent. SQLMap, Hydra, Metasploit. AUTHORIZATION REQUIRED.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "nexus-ml": {
      "description": "ML development subagent. Training, evaluation, deployment pipelines.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    },
    "nexus-code": {
      "description": "Code review and development subagent.",
      "mode": "subagent",
      "model": "ollama/goekdenizguelmez/JOSIEFIED-Qwen3:8b"
    }
  },

  "mcp": {
    "nexus-brain": {
      "type": "local",
      "command": ["python", "mcp_servers/llm_fallback.py"],
      "enabled": true
    },
    "nexus-memory": {
      "type": "local",
      "command": ["python", "mcp_servers/memory_mcp.py"],
      "enabled": true
    },
    "nexus-router": {
      "type": "local",
      "command": ["python", "mcp_servers/task_router_mcp.py"],
      "enabled": true
    },
    "nexus-security": {
      "type": "local",
      "command": ["python", "mcp_servers/pentest_mcp.py"],
      "enabled": true
    },
    "nexus-orchestrator": {
      "type": "local",
      "command": ["python", "mcp_servers/nexus_orchestrator_mcp.py"],
      "enabled": true
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "python *": "allow",
      "pip *": "allow",
      "ollama *": "allow",
      "nmap *": "ask",
      "nuclei *": "ask",
      "nikto *": "ask",
      "gobuster *": "ask",
      "sqlmap *": "ask",
      "hydra *": "ask",
      "git *": "allow",
      "curl *": "allow",
      "wsl *": "ask",
      "*": "ask"
    }
  }
}
