# NEXUS Environment Configuration
# API Keys — NEVER commit this file to git
# Format: SMART_KEY_N=auto-detect provider, or PROVIDER_KEY_N=explicit

# === Auto-Detect Keys (prefix determines provider) ===
# SMART_KEY_1=nvapi-xxxxx    # → NVIDIA
# SMART_KEY_2=gsk_xxxxx      # → Groq
# SMART_KEY_3=msk-xxxxx      # → Mistral
# SMART_KEY_4=AIzaxxxxx      # → Gemini
# SMART_KEY_5=tok_xxxxx       # → Together AI
# SMART_KEY_6=sk-or-xxxxx    # → OpenRouter
# SMART_KEY_7=coh-xxxxx      # → Cohere
# SMART_KEY_8=hf_xxxxx       # → HuggingFace
# SMART_KEY_9=sak-xxxxx      # → SambaNova

# === Explicit Provider Keys ===
# NVIDIA_API_KEY=nvapi-xxxxx
# GROQ_API_KEY=gsk_xxxxx
# MISTRAL_API_KEY=msk-xxxxx
# GEMINI_API_KEY=AIzaxxxxx
# TOGETHER_API_KEY=tok_xxxxx
# OPENROUTER_API_KEY=sk-or-xxxxx
# COHERE_API_KEY=coh-xxxxx
# HUGGINGFACE_API_KEY=hf_xxxxx
# SAMBANOVA_API_KEY=sak-xxxxx
# DEEPSEEK_API_KEY=sk-xxxxx
# OPENAI_API_KEY=sk-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# === Ollama (Local — No Key Needed) ===
OLLAMA_BASE_URL=http://localhost:11434

# === Security ===
# SHODAN_API_KEY=xxxxx

# === Notifications ===
# SLACK_WEBHOOK_URL=https://hooks.slack.com/xxx
# TELEGRAM_BOT_TOKEN=xxxxx
# TELEGRAM_CHAT_ID=xxxxx
